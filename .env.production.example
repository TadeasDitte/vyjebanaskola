# Production environment for docker-compose.prod.yml.
# Copy to .env on the server, fill in the blanks, keep it out of git.
#
# Unlike dev, these ARE injected as real container env vars (env_file).
# APP_KEY being set here is what tells the entrypoint it is running in
# production (generate one with: php artisan key:generate --show).

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Image to run; override to pin a release, e.g. ...:1.2.0 or ...:sha-abc1234
APP_IMAGE=ghcr.io/tadeasditte/vyjebanaskola:latest
# Host port nginx is published on
APP_PORT=80

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
# "db" is the compose service name in docker-compose.prod.yml
DB_HOST=db
DB_PORT=5432
DB_DATABASE=vyjebanaskola
DB_USERNAME=vyjebanaskola
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
